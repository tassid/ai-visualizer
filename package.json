{
  "name": "ai-visualizer",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive, step-by-step visualizations of machine learning algorithms, written from scratch for study.",
  "type": "module",
  "author": "Tassiane Anzolin",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-contour": "^4.0.3",
    "d3-hierarchy": "^3.1.3",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.3",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^3.2.1",
    "framer-motion": "^14.14.0",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
